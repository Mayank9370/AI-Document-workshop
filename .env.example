# ==============================================================================
# AI Document Workspace - Root Environment Template
# ==============================================================================
# For local development, copy backend/.env.example to backend/.env
# and frontend/.env.example to frontend/.env.local.
#
# DO NOT commit real secrets or credentials into version control.
# ==============================================================================

# Backend Service Configuration (backend/.env)
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database & Infrastructure
# MongoDB Atlas connection string (cloud cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ai_workspace?retryWrites=true&w=majority

# Redis (local Docker: redis://localhost:6379, container: redis://redis:6379)
REDIS_URL=redis://localhost:6379

# Qdrant Vector Store (local Docker: http://localhost:6333, container: http://qdrant:6333)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# AI Provider Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# Text Processing & Chunking Parameters
CHUNK_SIZE=900
CHUNK_OVERLAP=120

# Authentication & JWT Configuration
JWT_SECRET=your_jwt_secret_min_32_chars_long
JWT_EXPIRES_IN=1d

# Local Storage Directory for Uploaded PDFs
UPLOAD_DIR=uploads

# Admin User Seeding Configuration (Optional)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_NAME=System Administrator

# Frontend Configuration (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
