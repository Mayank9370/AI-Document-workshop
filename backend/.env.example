PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Required: MongoDB Atlas connection string (e.g. mongodb+srv://<username>:<password>@cluster.mongodb.net/ai_workspace?retryWrites=true&w=majority)
MONGODB_URI=

# Required: Redis URL (redis://localhost:6379 for host, redis://redis:6379 in Docker)
REDIS_URL=redis://localhost:6379

# Required: Qdrant URL (http://localhost:6333 for host, http://qdrant:6333 in Docker)
QDRANT_URL=http://localhost:6333
# Optional: Qdrant API Key
QDRANT_API_KEY=

# AI Provider Configuration (Phase 5 - Embedding & Processing)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# PDF Processing Configuration (Phase 5)
# CHUNK_SIZE: number of characters per chunk (default: 900)
CHUNK_SIZE=900
# CHUNK_OVERLAP: overlapping characters between consecutive chunks (default: 120)
CHUNK_OVERLAP=120

# Authentication & JWT Configuration (Phase 3)
JWT_SECRET=your_secure_jwt_secret_here
JWT_EXPIRES_IN=1d

# Upload Configuration (Phase 4)
UPLOAD_DIR=uploads

# Admin Seed Configuration (Phase 3 - Optional for seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_NAME=System Administrator
